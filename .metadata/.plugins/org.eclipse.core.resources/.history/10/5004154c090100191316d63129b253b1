package su.plugin.bparty.bungee.command;

import java.util.Random;

import net.md_5.bungee.api.ProxyServer;
import net.md_5.bungee.api.connection.ProxiedPlayer;
import su.plugin.blogin.common.api.BLoginAPI;
import su.plugin.bparty.bungee.GBPartyPlugin;
import su.plugin.bparty.bungee.api.GBPartyAPI;
import su.plugin.bparty.bungee.api.object.Party;
import su.plugin.bparty.bungee.api.object.PartyPlayer;
import su.plugin.core.common.api.Core;
import su.plugin.core.common.api.command.Command;
import su.plugin.core.common.api.command.CommandHandler;
import su.plugin.core.common.api.command.SubCommandHandler;
import su.plugin.core.common.api.command.UCommandListener;
import su.plugin.core.common.api.command.UCommandSender;
import su.plugin.core.common.api.player.UPlayer;

public class UserCommand implements UCommandListener {
	
	private GBPartyAPI api = GBPartyPlugin.getApi();
	
	@CommandHandler(
			name="파티",
			aliases= {"ㅍㅌ", "party", "p"}
			)
	public void party(UCommandSender sender, String[] args, Command cmd) {
		sender.nmsg(sender, "§a§l[ U-Party ]");
		for(Command sc : Core.getCommandManager().getSubCommands(cmd.getName(), 1)) {
			sc.sendUsageIfHasPermission(sender, false);
		}
	}
	
	@SubCommandHandler(
			parent="파티",
			name="초대",
			aliases= {"ㅊㄷ", "invite"},
			minArgs = 1,
			usage="플레이어를 파티에 초대합니다."
			)
	public void party_invite(UPlayer up, String[] args, Command cmd) {
		PartyPlayer pp = api.getPlayerManager().getPartyPlayer(up.getPlayerKey());
		
		if(!pp.hasParty()) {
			pp.setParty(new Party(up.getPlayerKey()));
		}
		
		if(pp.getParty().getPlayers().size() >= api.getMaxPartyCount()) {
			up.wmsg("파티가 가득 찼습니다.");
			return;
		}
		
		UPlayer target = Core.getUPlayer(args[0]);
		if(target == null) {
			up.wmsg("접속 중이 아닌 플레이어입니다.");
			return;
		}
		
		if(api.isUseBLogin() && (!BLoginAPI.getAccountManager().hasAccount(target.getPlayerKey()) || !BLoginAPI.getAccountManager().getAccount(target.getPlayerKey()).isLogin())) {
			up.wmsg("아직 로그인하지 않은 플레이어입니다.");
			return;
		}
		
		PartyPlayer targetPartyPlayer = api.getPlayerManager().getPartyPlayer(target.getPlayerKey());
		if(targetPartyPlayer.hasParty()) {
			up.wmsg("다른 파티에 참여 중인 플레이어입니다.");
			return;
		}
		
		targetPartyPlayer.setInvitedParty(pp.getParty());
		
		pp.getParty().bc("§f" + up.getDisplayName() + "§a님께서 §f" + target.getDisplayName() + "§a님을 파티에 초대했습니다!");
		Core.msg(target, "§f" + pp.getDisplayName() + "§a님께서 §f" + party.getName() + " §a파티에 초대했습니다! (/파티 수락 | /파티 거절)");
	}
	
	@SubCommandHandler(
			parent="파티",
			name="수락",
			aliases= {"ㅅㄹ", "accept"},
			usage="파티 초대를 수락합니다."
			)
	public void party_accept(ProxiedPlayer p, String[] args, Command cmd) {
		PartyPlayer pp = api.getPlayerManager().getPartyPlayer(p);
		
		if(pp.hasParty()) {
			Core.msg(p, "§c이미 파티에 가입되어있습니다.");
			return;
		} else if(pp.getInvitedPartyName() == null) {
			Core.msg(p, "§c아직 파티에 초대받지 못했습니다.");
			return;
		}
		
		Party party = api.getPartyManager().getParty(pp.getInvitedPartyName());
		
		if(party.getPlayerList().size() >= api.getMaxPartyCount()) {
			Core.msg(p, "§c파티가 가득 찼습니다.");
			return;
		}
		
		pp.setPartyName(party.getName());
		pp.setInvitedPartyName(null);
		
		party.bc("§f" + pp.getDisplayName()+ "§a님께서 파티에 참여했습니다!");
		party.addPlayer(p);
		
		api.getPlayerManager().sendPlayerToServer(p.getName(), party.getOwner().getServer().getInfo());
		api.getPartyManager().sendParty(party, party.getOwner().getServer().getInfo());
		
		Core.msg(p, "§f" + party.getName() + "§a파티에 참여했습니다!");
		
		//
		
		ProxiedPlayer op = party.getOwner();
		if(p.getServer().getInfo().equals(op.getServer().getInfo())) return;
		
		pp.setMoving(true);
		p.connect(op.getServer().getInfo());
		
		String targetName = op.getServer().getInfo().getName();
		if(api.isUseBEssentials()) {
			targetName = BEssentialsPlugin.getApi().getChannelManager().getChannel(targetName).getDisplayName();
		}
		
		Core.msg(p, "§a파티장을 따라 §f" + targetName + "§a으로 이동했습니다.");
	}
	
	@SubCommandHandler(
			parent="파티",
			name="거절",
			aliases= {"ㄱㅈ", "deny"},
			usage="파티 초대를 거절합니다."
			)
	public void party_deny(ProxiedPlayer p, String[] args, Command cmd) {
		PartyPlayer pp = api.getPlayerManager().getPartyPlayer(p);
		
		if(pp.hasParty()) {
			Core.msg(p, "§c이미 파티에 가입되어있습니다.");
			return;
		} else if(pp.getInvitedPartyName() == null) {
			Core.msg(p, "§c아직 파티에 초대받지 못했습니다.");
			return;
		}
		
		Party party = api.getPartyManager().getParty(pp.getInvitedPartyName());
		
		pp.setInvitedPartyName(null);
		
		Core.msg(p, "§f" + party.getName() + "§a파티의 초대를 거절했습니다!");
		party.bc("§f" + pp.getDisplayName() + "§a님께서 파티 초대를 거절했습니다!");
	}
	
	@SubCommandHandler(
			parent="파티",
			name="추방",
			aliases= {"ㅊㅂ", "강퇴", "ㄱㅌ", "kick"},
			usage="플레이어를 파티에서 추방합니다."
			)
	public void party_kick(ProxiedPlayer p, String[] args, Command cmd) {
		if(args.length < 1) {
			command.sendUsage(p, false);
			return;
		}
		
		PartyPlayer pp = api.getPlayerManager().getPartyPlayer(p);
		
		if(!pp.hasParty()) {
			Core.msg(p, "§c참여 중인 파티가 없습니다.");
			return;
		}
		
		Party party = api.getPartyManager().getParty(pp.getPartyName());
		
		if(!party.isOwner(p.getName())) {
			Core.msg(p, "§c파티장만 사용 가능합니다.");
			return;
		} else if(!party.existPlayer(args[1])) {
			Core.msg(p, "§c파티에 소속되어 있지 않은 플레이어입니다.");
			return;
		}
		
		ProxiedPlayer target = ProxyServer.getInstance().getPlayer(args[1]);
		
		party.removePlayer(target);
		
		PartyPlayer tp = api.getPlayerManager().getPartyPlayer(target);
		
		tp.setPartyName(null);
		tp.setPartyChat(false);
		
		api.getPartyManager().sendPartyLeave(target.getName(), p.getServer().getInfo());
		api.getPartyManager().sendParty(party, p.getServer().getInfo());
		
		Core.msg(target, "§c" + party.getName() + " 파티에서 추방당했습니다.");
		party.bc("§f" + pp.getDisplayName() + "님께서 " + tp.getDisplayName() + "님을 파티에서 추방했습니다.");
	}
	
	@SubCommandHandler(
			parent="파티",
			name="위임",
			aliases= {"ㅇㅇ", "giveLeader"},
			usage="플레이어에게 파티장을 위임합니다."
			)
	public void party_giveLeader(ProxiedPlayer p, String[] args, Command cmd) {
		if(args.length < 1) {
			command.sendUsage(p, false);
			return;
		}
		
		PartyPlayer pp = api.getPlayerManager().getPartyPlayer(p);
		
		if(!pp.hasParty()) {
			Core.msg(p, "참여 중인 파티가 없습니다!");
			return;
		}
		
		Party party = api.getPartyManager().getParty(pp.getPartyName());
		
		if(!party.isOwner(p.getName())) {
			Core.msg(p, "§c파티장만 사용 가능합니다.");
			return;
		} else if(!party.existPlayer(args[1])) {
			Core.msg(p, "§c파티에 소속되어 있지 않은 플레이어입니다.");
			return;
		}
		
		String target = ProxyServer.getInstance().getPlayer(args[1]).getName();
		
		party.setOwnerName(target);
		
		PartyPlayer tp = api.getPlayerManager().getPartyPlayer(target);
		
		api.getPartyManager().sendParty(party, tp.getPlayer().getServer().getInfo());
		
		party.bc("§f" + pp.getDisplayName() + "§a님께서 파티장을 §f" + tp.getDisplayName() +"§a님께 위임하셨습니다.");
	}
	
	@SubCommandHandler(
			parent="파티",
			name="탈퇴",
			aliases= {"ㅌㅌ", "leave"},
			usage="파티에서 탈퇴합니다."
			)
	public void party_leave(ProxiedPlayer p, String[] args, Command cmd) {
		PartyPlayer pp = api.getPlayerManager().getPartyPlayer(p);
		
		if(!pp.hasParty()) {
			Core.msg(p, "§c참여 중인 파티가 없습니다.");
			return;
		}
		
		Party party = api.getPartyManager().getParty(pp.getPartyName());
		
		party.removePlayer(p);
		
		pp.setPartyName(null);
		pp.setPartyChat(false);
		
		Core.msg(p, "§f" + party.getName() + " §a파티를 탈퇴했습니다.");
		
		if(party.getOnlinePlayers().size() < 1) {
			api.getPartyManager().removeParty(party);
			return;
		}
		
		api.getPartyManager().sendPartyLeave(p.getName(), p.getServer().getInfo());
		api.getPartyManager().sendParty(party, party.getOwner().getServer().getInfo());
		
		party.bc("§f" + pp.getDisplayName() + " §a님께서 파티에서 탈퇴했습니다.");
		
		if(p.getName().equalsIgnoreCase(party.getOwnerName())) {
			PartyPlayer np = api.getPlayerManager().getPartyPlayer(party.getOnlinePlayers().get(new Random().nextInt(party.getOnlinePlayers().size())));
			party.setOwnerName(np.getName());
			party.bc("§a파티장이 §f" + np.getDisplayName() + "§a님께 위임되었습니다.");
		}
	}
	
	@SubCommandHandler(
			parent="파티",
			name="채팅",
			aliases= {"ㅊㅌ", "chat"},
			permission="bparty.use",
			usage="파티 채팅 모드로 전환하거나 해제합니다."
			)
	public void party_chat(ProxiedPlayer p, String[] args, Command cmd) {
		PartyPlayer gp = api.getPlayerManager().getPartyPlayer(p);
		
		if(!gp.hasParty()) {
			Core.msg(p, "§c참여 중인 파티가 없습니다.");
			return;
		} else if(gp.isPartyChat()) {
			gp.setPartyChat(false);
			api.getPlayerManager().sendPlayerToServer(p.getName(), p.getServer().getInfo());
			Core.msg(p, "§c파티 채팅 모드가 해제되었습니다.");
			return;
		}
		
		gp.setPartyChat(true);
		
		api.getPlayerManager().sendPlayerToServer(p.getName(), p.getServer().getInfo());
		
		Core.msg(p, "§c파티 채팅 모드로 전환되었습니다.");
	}
	
	@SubCommandHandler(
			parent="파티",
			name="정보",
			aliases= {"ㅈㅂ", "info"},
			usage="파티 정보를 확인합니다."
			)
	public void party_info(ProxiedPlayer p, String[] args, Command cmd) {
		Party party;
		
		if(args.length < 1) {
			PartyPlayer gp = api.getPlayerManager().getPartyPlayer(p);
			
			if(!gp.hasParty()) {
				Core.msg(p, "§c참여 중인 파티가 없습니다.");
				return;
			}
			
			party = api.getPartyManager().getParty(gp.getPartyName());
		} else {
			party = api.getPartyManager().getParty(args[1]);
			
			if(party == null) {
				Core.msg(p, "§c존재하지 않는 파티입니다.");
				return;
			}
		}
		
		Core.nmsg(p, "§f" + party.getName() + " §a파티 정보");
		Core.nmsg(p, "§a파티장: §f" + api.getPlayerManager().getPartyPlayer(party.getOwner()).getDisplayName());
		Core.nmsg(p, "§a파티 중인 플레이어(" + party.getOnlinePlayers().size() + "): §f" + api.buildPlayerList(party.getOnlinePlayers()));
	}
	
}