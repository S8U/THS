package su.plugin.bessentials.bungee.api.manager;

import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.regex.Pattern;

import lombok.Getter;
import lombok.Setter;
import net.md_5.bungee.api.CommandSender;
import net.md_5.bungee.api.ProxyServer;
import net.md_5.bungee.api.connection.ProxiedPlayer;
import shadowuni.plugin.b.Corerary.api.Corerary;
import su.plugin.bessentials.bungee.GBEssentialsPlugin;
import su.plugin.bessentials.bungee.api.GBEssentialsAPI;
import su.plugin.bessentials.bungee.api.category.ListeningChannel;
import su.plugin.bessentials.bungee.api.object.EChannel;
import su.plugin.bessentials.bungee.api.object.EPlayer;
import su.plugin.core.common.api.Core;
import su.plugin.core.common.api.util.StringUtil;

public class ChatManager {
	
	private GBEssentialsAPI api = GBEssentialsPlugin.getApi();
	
	@Setter
	@Getter
	private HashMap<String, Integer> banWords = new HashMap<>();
	
	@Setter
	@Getter
	private boolean muteAll;
	
	public void sendGlobalChat(EPlayer ep, String msg) {
		List<String> replacedChat = replaceChat(msg);
		String message= replacedChat.get(0);
		
		EChannel channel = ep.getEChannel();
		
		Core.nlog("§7[" + channel.getName() + "] §f" + ep.getPrefixerPrefix() + " §f" + ep.getPermissionPrefix() + " §f" + ep.getName() + " : §f" + msg);
		
		String chat = channel.getChatForm().replace("{channel_name}", channel.getName()).replace("{channel_displayname}", channel.getDisplayName()).replace("{prefixer_prefix}", ep.getPrefixerPrefix()).replace("{permission_prefix}", ep.getPermissionPrefix()).replace("{name}", ep.getPermissionPrefix()).replace("{message}", message);
		
		for(EPlayer aep : api.getPlayerManager().getOnlineEPlayers()) {
			if(aep.getEChannel().equals(ep.getEChannel()) || aep.getListeningChannel() == ListeningChannel.LOCAL) continue;
			Core.nmsg(aep.getProxiedPlayer(), chat);
		}
		
		// Warning
		
		int count = api.getWarningManager().giveWarning(ep.getPlayerKey(), replacedChat);
		Core.nmsg(ep.getProxiedPlayer(), api.getWarningManager().getWarningMessage().replace("{count}", String.valueOf(count)).replace("{total_count}", String.valueOf(ep.getWarning())));
		
		api.getWarningManager().executeWarningEvent(ep);
	}
	
	public void sendAdminChat(EPlayer ep, String msg) {
		List<String> replacedChat = replaceChat(msg);
		String message= replacedChat.get(0);
		
		EChannel channel = ep.getEChannel();
		
		String chat = "§7<AdminChat> [" + channel.getName() + "] §f" + ep.getPrefixerPrefix() + " §f" + ep.getPermissionPrefix() + " §f" + ep.getName() + " §7: §f" + message;
		
		Core.nlog(chat);
		
		for(EPlayer aep : api.getPlayerManager().getOnlineAdminChats()) {
			if(aep.getEChannel().equals(ep.getEChannel()) || aep.getListeningChannel() == ListeningChannel.LOCAL) continue;
			Core.nmsg(aep.getProxiedPlayer(), chat);
		}
		
		// Warning
		
		int count = api.getWarningManager().giveWarning(ep.getPlayerKey(), replacedChat);
		Core.nmsg(ep.getProxiedPlayer(), api.getWarningManager().getWarningMessage().replace("{count}", String.valueOf(count)).replace("{total_count}", String.valueOf(ep.getWarning())));
		
		api.getWarningManager().executeWarningEvent(ep);
	}
	
	public void sendWhisper(CommandSender sender, ProxiedPlayer target, String msg) {
		// Target Login Check
		
		String senderName = sender instanceof ProxiedPlayer ? sender.getName() : "콘솔";
		String senderDisplayName = api.getDisplayName(sender);
		
		EPlayer tp = api.getEPlayer(target);
		
		List<String> replacedChat = replaceChat(msg);
		String message= replacedChat.get(0);
		
		Core.nmsg(sender, "§7[§f나 → §e" + tp.getDisplayName() + "§7] " + message);
		
		boolean ignored = tp.isIgnoreAllWhisper() || (sender instanceof ProxiedPlayer && tp.isChatIgnored(Corerary.getPlayerKey((ProxiedPlayer) sender)));
		if(!ignored) {
			Core.nmsg(target, "§7[§e" + senderDisplayName + " → §f나§7] " + message);
		}
		
		tp.setLastWhisper(senderName);
		
		// Chat Spy
		
		String suffixMessage = "§7" + (ignored ? "[무시됨]" : "") + "[§e" + senderName + "§7 → §e" + tp.getDisplayName() + "§7]";
		String originalMessage = replacedChat.size() > 1 ? "§7[원본] " + suffixMessage + " " + msg : null;
		
		Core.nlog(suffixMessage + " " + msg);
		
		for(EPlayer ep : api.getPlayerManager().getOnlineChatSpys()) {
			Core.nmsg(ep.getProxiedPlayer(), "§7<ChatSpy> " + suffixMessage + " " + message);
			
			if(originalMessage == null) continue;
			Core.nmsg(ep.getProxiedPlayer(), originalMessage);
		}
		
		// Warning
		
		if(!(sender instanceof ProxiedPlayer)) return;
		
		EPlayer ep = api.getEPlayer((ProxiedPlayer) sender);
		
		int count = api.getWarningManager().giveWarning(ep.getPlayerKey(), replacedChat);
		Core.nmsg(ep.getProxiedPlayer(), api.getWarningManager().getWarningMessage().replace("{count}", String.valueOf(count)).replace("{total_count}", String.valueOf(ep.getWarning())));
		
		api.getWarningManager().executeWarningEvent(ep);
	}
	
	public List<String> replaceChat(String message) {
		String[] chars = new String[message.length()];
		for (int i = 0; i < chars.length; i++) {
			chars[i] = String.valueOf(message.charAt(i));
		}
		
		message = message.toLowerCase();
		for(ProxiedPlayer player : ProxyServer.getInstance().getPlayers()) {
			message = message.replace(player.getName().toLowerCase(), replaceWordTo(player.getName(), "-"));
		}
		
		List<String> list = new ArrayList<>();
		for(String word : banWords.keySet()) {
			List<Integer> rWord = replaceWord(message, word);
			for(int i : rWord) {
				chars[i] = "*";
			}
			if(rWord.size() < 1) continue;
			list.add(word);
		}
		
		list.add(0, StringUtil.connectString(chars, ""));
		return list;
	}
	
	public List<Integer> replaceWord(String message, String word) {
		String p = "[^a-zA-Zㄱ-ㅎ가-힣]";
		if(Pattern.matches("[a-zA-Z]*", word)) {
			p = "[^a-zA-Z]";
		} else if(Pattern.matches("[가-힣]*", word)) {
			p = "[^가-힣]";
		} else if(Pattern.matches("[ㄱ-ㅎ]*", word)) {
			p = "[^ㄱ-ㅎ]";
		}
		
		String[] chars = new String[message.length()];
		int[] num = new int[chars.length];
		int j = 0;
		for (int i = 0; i < chars.length; i++) {
			chars[i] = String.valueOf(message.charAt(i));
			if(Pattern.matches(p, String.valueOf(chars[i]))) continue;
			num[j++] = i;
		}
		
		String temp = message.replaceAll(p, "").replace(word, replaceWordTo(word, "*"));
		List<Integer> r = new ArrayList<>();
		for (int i = 0; i < temp.length(); i++) {
			if(!String.valueOf(temp.charAt(i)).equals("*")) continue;
			r.add(num[i]);
		}
		
		return r;
	}
	
	public String replaceWordTo(String word, String c) {
		return StringUtil.repeatString(c, word.length());
	}
	
}