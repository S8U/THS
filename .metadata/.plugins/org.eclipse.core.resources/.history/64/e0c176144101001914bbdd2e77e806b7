package su.plugin.core.common.api.util;

import java.io.File;
import java.io.FileInputStream;
import java.io.FileOutputStream;
import java.io.IOException;
import java.nio.channels.FileChannel;

import lombok.SneakyThrows;

public class FileUtil {
	
	public static void copy(File file, File target) {
		copy(file, target.getPath());
	}
	
	@SneakyThrows(IOException.class)
	public static void copy(File file, String path) {
		String dir = file.isDirectory() ? path : path + file.getName();
		File folder = new File(path);
		
		folder.mkdirs();
		
		if(file.isDirectory()) {
			for(File f : file.listFiles()) {
				copy(f, path + "\\" + file.getName());
			}
			return;
		}
		
		String newPath = path + "\\" + file.getName();
		
		FileInputStream fis = new FileInputStream(file);
		FileOutputStream fos = new FileOutputStream(newPath);
		
		FileChannel fci = fis.getChannel();
		FileChannel fco = fos.getChannel();
		
		fci.transferTo(0, fci.size(), fco);
		
		fco.close();
		fci.close();
		
		fos.close();
		fis.close();
	}
	
	public static void delete(File file) {
		if(file.isDirectory()) {
			for(File f : file.listFiles()) {
				delete(f);
			}
		}
		
		file.delete();
	}
	
}